# Mode Aplikasi: 'development' untuk komputer lokal, 'production' untuk server
NODE_ENV=development

# Port Backend API Express
PORT=8000

# ----------------------------------------------------------
# KONFIGURASI DATABASE MYSQL (LOKAL / XAMPP)
# ----------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=sipelita_desa
DB_USER=root
DB_PASSWORD=

